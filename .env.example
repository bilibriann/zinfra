# Endpoint del servicio de formularios. Para Web3Forms:
# https://api.web3forms.com/submit
NEXT_PUBLIC_FORMS_ENDPOINT=

# access_key de Web3Forms — debe crearse con el correo corporativo de ZINFRA
# Solutions, nunca con el correo personal del desarrollador.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Correo corporativo al que se dirigen las cotizaciones y que se muestra en
# /contacto como alternativa cuando el envío falla. Pendiente del cliente.
NEXT_PUBLIC_CONTACT_EMAIL=
