# Hostinger / Apache — el export de Next genera "contacto.html", no
# "contacto/index.html". Sin estas reglas, /contacto responde 404.

Options -MultiViews -Indexes
DirectoryIndex index.html

# El export crea DOS cosas por ruta: contacto.html y una carpeta contacto/ con
# los payloads RSC. Sin esto Apache ve el directorio, redirige a /contacto/ y
# devuelve 403 porque adentro no hay index.html.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /contacto  ->  /contacto.html  (solo si el archivo existe)
  # Sin "!-d" a propósito: el .html tiene que ganarle a la carpeta homónima.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Assets con hash: cache larga. HTML: siempre revalidar.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
